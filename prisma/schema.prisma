generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String              @id @default(cuid())
  email                       String              @unique
  username                    String?             @unique
  name                        String
  password                    String?
  role                        UserRole            @default(client)
  emailVerified               Boolean             @default(false) @map("email_verified")
  profileSetupCompleted       Boolean             @default(false) @map("profile_setup_completed")
  avatarUrl                   String?             @map("avatar_url")
  companyName                 String?             @map("company_name")
  position                    String?
  bio                         String?
  skills                      String?
  experience                  String?
  preferredJobTypes           String              @default("") @map("preferred_job_types")
  phone                       String?
  website                     String?
  location                    String?
  connections                 Int                 @default(10)
  connectionsLastRefresh      DateTime?           @map("connections_last_refresh")
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")
  preferredLanguage           String?             @default("bs") @map("preferred_language")
  accounts                    Account[]
  applications                Application[]
  connectionHistory           ConnectionHistory[]
  conversationsAsParticipant1 Conversation[]      @relation("ConversationsAsParticipant1")
  conversationsAsParticipant2 Conversation[]      @relation("ConversationsAsParticipant2")
  postedJobs                  JobListing[]        @relation("JobPoster")
  jobViews                    JobView[]
  messagesSent                Message[]           @relation("MessagesSent")
  notifications               Notification[]
  reviewsReceived             Review[]            @relation("ReviewsReceived")
  reviewsGiven                Review[]            @relation("ReviewsGiven")
  savedJobs                   SavedJob[]
  sessions                    Session[]
  stripeTransactions          StripeTransaction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PendingRegistration {
  id              String   @id @default(cuid())
  email           String   @unique
  hashedPassword  String   @map("hashed_password")
  verificationCode String  @map("verification_code")
  expires         DateTime
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model City {
  id          String       @id @default(cuid())
  key         String       @unique
  nameBS      String       @map("name_bs")
  nameEN      String       @map("name_en")
  latitude    Float?       @map("latitude")
  longitude   Float?       @map("longitude")
  isSpecial   Boolean      @default(false) @map("is_special")
  sortOrder   Int          @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("cities")
}

model JobListing {
  id                   String         @id @default(cuid())
  title                String
  company              String
  cityId               String         @map("city_id")
  categoryId           String?        @map("category_id")
  type                 JobType
  description          String
  requirements         String?
  benefits             String?
  salary               String?
  salaryType           SalaryType?    @map("salary_type")
  salaryMin            Int?           @map("salary_min")
  salaryMax            Int?           @map("salary_max")
  email                String
  website              String?
  applicationUrl       String?        @map("application_url")
  contactEmail         String?        @map("contact_email")
  isFeatured           Boolean        @default(false) @map("is_featured")
  tags                 String?
  startDate            DateTime?      @map("start_date")
  startTime            String?        @map("start_time")
  duration             String?        @map("duration")
  transportation       String         @default("not_provided") @map("transportation")
  transportationAmount Int?           @map("transportation_amount")
  expiresAt            DateTime?      @map("expires_at")
  status               JobStatus      @default(active)
  jobAddress           String?        @map("job_address")
  jobLatitude          Float?         @map("job_latitude")
  jobLongitude         Float?         @map("job_longitude")
  isActive             Boolean        @default(true) @map("is_active")
  postedById           String         @map("posted_by_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  applications         Application[]
  conversations        Conversation[]
  assignment           JobAssignment?
  postedBy             User           @relation("JobPoster", fields: [postedById], references: [id])
  views                JobView[]
  reviews              Review[]
  savedBy              SavedJob[]

  @@map("job_listings")
}

model Application {
  id            String            @id @default(cuid())
  jobId         String            @map("job_id")
  userId        String            @map("user_id")
  message       String?
  resume        String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  appliedAt     DateTime          @default(now()) @map("applied_at")
  clientNotes   String?           @map("client_notes")
  feedback      String?
  rejectedAt    DateTime?         @map("rejected_at")
  reviewedAt    DateTime?         @map("reviewed_at")
  selectedAt    DateTime?         @map("selected_at")
  shortlistedAt DateTime?         @map("shortlisted_at")
  withdrawnAt   DateTime?         @map("withdrawn_at")
  status        ApplicationStatus @default(PENDING)
  job           JobListing        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment    JobAssignment?    @relation("SelectedApplication")

  @@unique([jobId, userId])
  @@map("applications")
}

model JobAssignment {
  id                    String         @id @default(cuid())
  jobId                 String         @unique @map("job_id")
  selectedApplicationId String         @unique @map("selected_application_id")
  contractStatus        ContractStatus @default(PENDING)
  assignedAt            DateTime       @default(now()) @map("assigned_at")
  startDate             DateTime?      @map("start_date")
  agreedSalary          Int?           @map("agreed_salary")
  notes                 String?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  job                   JobListing     @relation(fields: [jobId], references: [id])
  selectedApplication   Application    @relation("SelectedApplication", fields: [selectedApplicationId], references: [id])

  @@map("job_assignments")
}

model SavedJob {
  id        String     @id @default(cuid())
  jobId     String     @map("job_id")
  userId    String     @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@map("saved_jobs")
}

model Category {
  id          String       @id @default(cuid())
  key         String       @unique
  nameBS      String       @map("name_bs")
  nameEN      String       @map("name_en")
  description String?
  icon        String?
  color       String?
  parentId    String?      @map("parent_id")
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  isPopular   Boolean      @default(false) @map("is_popular")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")

  @@map("categories")
}

model ConnectionHistory {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  action      ConnectionAction
  amount      Int
  description String?
  jobId       String?          @map("job_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("connection_history")
}

model StripeTransaction {
  id                    String   @id @default(cuid())
  stripePaymentIntentId String   @unique @map("stripe_payment_intent_id")
  userId                String   @map("user_id")
  amount                Int
  currency              String   @default("usd")
  status                String
  description           String?
  metadata              Json?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stripe_transactions")
}

model Review {
  id         String      @id @default(cuid())
  rating     Int
  comment    String?
  reviewerId String      @map("reviewer_id")
  revieweeId String      @map("reviewee_id")
  jobId      String?     @map("job_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  job        JobListing? @relation(fields: [jobId], references: [id])
  reviewee   User        @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   User        @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, revieweeId, jobId])
  @@map("reviews")
}

model Conversation {
  id            String      @id @default(cuid())
  participant1  String      @map("participant1_id")
  participant2  String      @map("participant2_id")
  jobId         String?     @map("job_id")
  lastMessageAt DateTime?   @map("last_message_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  job           JobListing? @relation(fields: [jobId], references: [id])
  user1         User        @relation("ConversationsAsParticipant1", fields: [participant1], references: [id], onDelete: Cascade)
  user2         User        @relation("ConversationsAsParticipant2", fields: [participant2], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([participant1, participant2, jobId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model JobView {
  id        String     @id @default(cuid())
  jobId     String     @map("job_id")
  userId    String?    @map("user_id")
  ipAddress String?    @map("ip_address")
  userAgent String?    @map("user_agent")
  createdAt DateTime   @default(now()) @map("created_at")
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@unique([jobId, ipAddress])
  @@map("job_views")
}

enum UserRole {
  admin
  client
  tasker
  company
}

enum JobType {
  quick_job
  full_time
  part_time
  remote
}

enum SalaryType {
  fixed
  hourly
  daily
  weekly
  monthly
  negotiable
}

enum JobStatus {
  active
  inactive
  completed
  expired
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum ConnectionAction {
  MONTHLY_REFRESH
  INITIAL_SIGNUP
  JOB_APPLICATION
  JOB_POST_CLIENT
  JOB_POST_COMPANY
  ADMIN_ADJUSTMENT
  PURCHASE
  JOB_POST_FREE
}

enum NotificationType {
  NEW_MESSAGE
  NEW_REVIEW
  JOB_APPLICATION
  JOB_UPDATE
  SYSTEM
}
