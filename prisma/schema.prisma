generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  username               String?             @unique
  name                   String
  password               String?
  role                   UserRole            @default(tasker)
  avatarUrl              String?             @map("avatar_url")
  companyName            String?             @map("company_name")
  position               String?
  bio                    String?
  skills                 String?
  experience             String?
  preferredJobTypes      String[]            @default([]) @map("preferred_job_types")
  phone                  String?
  website                String?
  location               String?
  connections            Int                 @default(10)
  connectionsLastRefresh DateTime?           @map("connections_last_refresh")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  accounts               Account[]
  applications           Application[]
  connectionHistory      ConnectionHistory[]
  postedJobs             JobListing[]        @relation("JobPoster")
  sessions               Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model City {
  id          String       @id @default(cuid())
  key         String       @unique
  nameBS      String       @map("name_bs")
  nameEN      String       @map("name_en")
  latitude    Float?       @map("latitude")
  longitude   Float?       @map("longitude")
  isSpecial   Boolean      @default(false) @map("is_special")
  sortOrder   Int          @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  jobListings JobListing[]

  @@map("cities")
}

model JobListing {
  id                   String        @id @default(cuid())
  title                String
  company              String
  cityId               String        @map("city_id")
  categoryId           String?       @map("category_id")
  type                 JobType
  description          String
  requirements         String?
  benefits             String?
  salary               String?
  salaryType           SalaryType?   @map("salary_type")
  salaryMin            Int?          @map("salary_min")
  salaryMax            Int?          @map("salary_max")
  email                String
  website              String?
  applicationUrl       String?       @map("application_url")
  contactEmail         String?       @map("contact_email")
  isFeatured           Boolean       @default(false) @map("is_featured")
  tags                 Json?
  startDate            DateTime?     @map("start_date")
  startTime            String?       @map("start_time")
  duration             String?       @map("duration")
  transportation       String        @default("not_provided") @map("transportation")
  transportationAmount Int?          @map("transportation_amount")
  expiresAt            DateTime?     @map("expires_at")
  status               JobStatus     @default(active)
  jobAddress           String?       @map("job_address")
  jobLatitude          Float?        @map("job_latitude")
  jobLongitude         Float?        @map("job_longitude")
  isActive             Boolean       @default(true) @map("is_active")
  postedById           String        @map("posted_by_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  applications         Application[]
  category             Category?     @relation(fields: [categoryId], references: [id])
  city                 City          @relation(fields: [cityId], references: [id])
  postedBy             User          @relation("JobPoster", fields: [postedById], references: [id])

  @@map("job_listings")
}

model Application {
  id        String     @id @default(cuid())
  jobId     String     @map("job_id")
  userId    String     @map("user_id")
  status    String     @default("pending")
  message   String?
  resume    String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@map("applications")
}

model Category {
  id          String       @id @default(cuid())
  key         String       @unique
  nameBS      String       @map("name_bs")
  nameEN      String       @map("name_en")
  description String?
  icon        String?
  color       String?
  parentId    String?      @map("parent_id")
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  isPopular   Boolean      @default(false) @map("is_popular")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")
  jobListings JobListing[]

  @@map("categories")
}

model ConnectionHistory {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  action      ConnectionAction
  amount      Int
  description String?
  jobId       String?          @map("job_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("connection_history")
}

enum ConnectionAction {
  MONTHLY_REFRESH
  INITIAL_SIGNUP
  JOB_APPLICATION
  JOB_POST_EMPLOYER
  JOB_POST_COMPANY
  ADMIN_ADJUSTMENT
  PURCHASE
}

enum UserRole {
  admin
  client
  tasker
  company
}

enum JobType {
  full_time
  part_time
  remote
  quick_job
}

enum SalaryType {
  fixed
  hourly
  daily
  weekly
  monthly
}

enum JobStatus {
  active
  inactive
  completed
  expired
}
