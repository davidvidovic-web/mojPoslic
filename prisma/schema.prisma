// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  employer
  employee
}

enum JobType {
  full_time
  part_time
  contract
  remote
  quick_job
}

enum SalaryType {
  fixed
  hourly
  daily
  weekly
  monthly
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?  // For email/password auth
  role      UserRole @default(employee)
  avatarUrl String?  @map("avatar_url")
  
  // Employer-specific fields
  companyName String? @map("company_name")
  
  // Employee-specific fields
  position String?
  bio      String?
  skills   String? // Comma-separated skills
  experience String? // Work experience description
  preferredJobTypes String[] @default([]) @map("preferred_job_types") // Array of job types
  
  // Contact information
  phone    String?
  website  String?
  location String?
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  postedJobs    JobListing[] @relation("JobPoster")
  applications  Application[]
  sessions      Session[]
  accounts      Account[]
  
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model City {
  id        String   @id @default(cuid())
  key       String   @unique
  nameBS    String   @map("name_bs")
  nameEN    String   @map("name_en")
  isSpecial Boolean  @default(false) @map("is_special")
  sortOrder Int      @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  jobListings JobListing[]
  
  @@map("cities")
}

model JobListing {
  id            String    @id @default(cuid())
  title         String
  company       String
  cityId        String    @map("city_id")
  categoryId    String?   @map("category_id")  // Added category relation
  type          JobType
  description   String
  requirements  String?
  benefits      String?
  salary        String?
  salaryType    SalaryType? @map("salary_type") // fixed, weekly, monthly
  salaryMin     Int?        @map("salary_min")  // Minimum salary amount
  salaryMax     Int?        @map("salary_max")  // Maximum salary amount
  email         String
  website       String?
  applicationUrl String?  @map("application_url")
  contactEmail  String?   @map("contact_email")
  isFeatured    Boolean   @default(false) @map("is_featured")
  tags          Json?     // JSON array of tags
  startDate     DateTime? @map("start_date")   // When the job/work should start
  expiresAt     DateTime? @map("expires_at")
  
  // Location fields
  jobAddress    String?   @map("job_address")    // Full address of the job location
  jobLatitude   Float?    @map("job_latitude")   // Latitude coordinate
  jobLongitude  Float?    @map("job_longitude")  // Longitude coordinate
  
  isActive      Boolean   @default(true) @map("is_active")
  
  // Relations
  city         City          @relation(fields: [cityId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])  // Added category relation
  postedBy     User          @relation("JobPoster", fields: [postedById], references: [id])
  postedById   String        @map("posted_by_id")
  applications Application[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("job_listings")
}

model Application {
  id        String   @id @default(cuid())
  jobId     String   @map("job_id")
  userId    String   @map("user_id")
  status    String   @default("pending") // pending, reviewed, accepted, rejected
  message   String?  // Cover letter or application message
  resume    String?  // URL to uploaded resume
  
  // Relations
  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@unique([jobId, userId]) // One application per user per job
  @@map("applications")
}

model Category {
  id          String   @id @default(cuid())
  key         String   @unique
  nameBS      String   @map("name_bs")
  nameEN      String   @map("name_en")
  description String?
  icon        String?  // Icon identifier for UI
  color       String?  // Color code for UI theming
  
  // Hierarchical structure
  parentId    String?  @map("parent_id")
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  // Ordering and display
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isPopular   Boolean  @default(false) @map("is_popular")
  
  // Metadata
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  jobListings JobListing[]
  
  @@map("categories")
}
