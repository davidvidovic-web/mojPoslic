# Database Configuration
DATABASE_URL="postgresql://username:password@hostname:5432/database_name"

# Auth.js Configuration (Required)
NEXTAUTH_URL="https://your-domain.vercel.app"
AUTH_URL="http://localhost:3000" # For development
NEXTAUTH_SECRET="generate-a-secure-32-character-random-string"

# OAuth Providers (Configure at least one)
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# Email Configuration (Optional - for transactional emails)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="mojPoslić <noreply@yourdomain.com>"

# Stripe Configuration (Optional - for payments)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Google Maps Configuration (Optional - for job location maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
