# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests
/__tests__
*.test.*
*.spec.*

# next.js
/.next/
/out/

# production
/build
/dist
/dev

# misc
.DS_Store
*.pem

# cache files (but keep directory structure)
/public/cache/*.json
/public/cache/metadata.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/src/generated/prisma
/prisma/migrations/.env

# development artifacts
*.backup
*.bak
*.orig
*~
*.tmp
*.temp
*-new.*
*-old.*
*-backup.*
*-copy.*
*-draft.*
*refactor*
scripts/
database/
*.sql
*.log

