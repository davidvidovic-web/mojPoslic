{
  "name": "mojposlic",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --no-engine && npm run cache:generate && next build",
    "cache:generate": "node scripts/generate-cache.js",
    "cache:update": "curl -X POST https://mojposlic.com/api/cache/update",
    "deploy:cache": "bash scripts/post-deploy.sh",
    "postinstall": "prisma generate --no-engine",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check",
    "check:fix": "npm run lint:fix && npm run type-check",
    "db:push": "prisma db push",
    "db:generate": "prisma generate --no-engine"
  },
